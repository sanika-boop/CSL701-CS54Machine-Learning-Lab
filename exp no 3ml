        "# ------------------------------------------------------------\n",
        "# STEP 3: Calculate Total Sum of Squares (TSS)\n",
        "#\n",
        "# TSS = Σ(y_i - y_mean)²\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "TSS = np.sum((actual - y_mean) ** 2)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Calculate RSS\n",
        "#\n",
        "# RSS = Σ(y_i - y_hat_i)²\n",
        "# ------------------------------------------------------------\n",
