    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# TASK 16: PREDICT SELLING PRICES\n",
        "# Google Colab - Complete Working Code\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.datasets import fetch_california_housing\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1: Load dataset\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "housing = fetch_california_housing()\n",
        "\n",
        "X = pd.DataFrame(\n",
        "    housing.data,\n",
        "    columns=housing.feature_names\n",
        ")\n",
        "\n",
        "y = pd.Series(\n",
        "    housing.target,\n",
        "    name=\"Selling Price\"\n",
        ")\n",
        "\n",
        "print(\"Dataset loaded successfully.\")\n",
        "print(\"X shape:\", X.shape)\n",
        "print(\"y shape:\", y.shape)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 2: Split dataset into training and testing data\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "print(\"\\nTraining data:\", X_train.shape)\n",
        "print(\"Testing data :\", X_test.shape)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3: Add intercept column\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X_train_matrix = np.column_stack([\n",
        "    np.ones(len(X_train)),\n",
        "    X_train.values\n",
        "])\n",
        "\n",
        "X_test_matrix = np.column_stack([\n",
        "    np.ones(len(X_test)),\n",
        "    X_test.values\n",
        "])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Calculate regression coefficient vector beta_hat\n",
        "# Using Ordinary Least Squares:\n",
        "#\n",
        "# beta_hat = (X^T X)^(-1) X^T y\n",
        "#\n",
        "# pinv is used for numerical stability.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "beta_hat = np.linalg.pinv(X_train_matrix) @ y_train.values\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5: Predict selling prices\n",
        "#\n",
        "# Equation:\n",
        "# y_hat_test = X_test beta_hat\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "y_pred_test = X_test_matrix @ beta_hat\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6: Create comparison table\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "comparison = pd.DataFrame({\n",
        "    \"Actual Selling Price\": y_test.values,\n",
        "    \"Predicted Selling Price\": y_pred_test\n",
        "})\n",
        "\n",
        "comparison = comparison.reset_index(drop=True)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7: Display sample comparison\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"TASK 16: ACTUAL VS PREDICTED SELLING PRICES\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "display(comparison.head(10))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 8: Display beta_hat\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nRegression Coefficient Vector (beta_hat):\")\n",
        "print(beta_hat)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 9: Display prediction shape\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nNumber of test samples:\", len(y_test))\n",
        "print(\"Number of predictions :\", len(y_pred_test))\n",
