        "X_train_scaled[numerical_features] = (\n",
        "    X_train[numerical_features] - train_mean\n",
        ") / train_std\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 6: Standardize test features\n",
        "#         USING THE TRAINING MEAN AND STD\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "X_test_scaled = X_test.copy()\n",
        "\n",
        "X_test_scaled[numerical_features] = (\n",
        "    X_test[numerical_features] - train_mean\n",
        ") / train_std\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 7: Display results\n",
