        "\n",
        "# Find Selling_Price column\n",
        "target_column = None\n",
        "\n",
        "for column in df.columns:\n",
        "    if column.lower().replace(\" \", \"_\") == \"selling_price\":\n",
        "        target_column = column\n",
        "        break\n",
        "\n",
        "# Check whether Selling_Price exists\n",
        "if target_column is None:\n",
        "    print(\"\\nERROR: Selling_Price column was not found.\")\n",
        "    print(\"Please check the column names displayed above.\")\n",
        "else:\n",
        "    # Separate target variable\n",
        "    target = df[target_column]\n",
        "\n",
        "    # Separate input features\n",
        "    features = df.drop(columns=[target_column])\n",
        "\n",
        "    print(\"\\nTarget variable:\", target_column)\n",
        "    print(\"Target shape:\", target.shape)\n",
        "\n",
