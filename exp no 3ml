        "# STEP 2: Calculate residuals\n",
        "# Formula:\n",
        "# e_i = y_i - y_hat_i\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "residuals = actual - predicted\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3: Calculate Squared Residuals\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "squared_residuals = residuals ** 2\n",
