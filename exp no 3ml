        "# TASK 15: INTERPRET THE REGRESSION COEFFICIENTS\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1: Check that the regression coefficients exist\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if \"beta\" not in globals():\n",
        "    raise ValueError(\"Regression coefficients 'beta' were not found. Please run Task 14 first.\")\n",
        "\n",
        "beta = np.asarray(beta, dtype=float).reshape(-1)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 2: Get feature names\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if \"X_train\" not in globals():\n",
        "    raise ValueError(\"X_train was not found. Please run Task 9 first.\")\n",
        "\n",
        "if isinstance(X_train, pd.DataFrame):\n",
        "    feature_names = X_train.columns.tolist()\n",
        "else:\n",
        "    feature_names = [\n",
        "        \"Feature_\" + str(i + 1)\n",
        "        for i in range(len(beta) - 1)\n",
        "    ]\n",
        "\n",
        "# Make sure the number of names matches the coefficients\n",
        "if len(feature_names) != len(beta) - 1:\n",
        "    feature_names = [\n",
        "        \"Feature_\" + str(i + 1)\n",
        "        for i in range(len(beta) - 1)\n",
        "    ]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3: Create coefficient table\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "coefficients = beta[1:]\n",
        "\n",
        "coefficient_table = pd.DataFrame({\n",
        "    \"Feature\": feature_names,\n",
        "    \"Coefficient\": coefficients\n",
        "})\n",
        "\n",
        "# Determine whether each coefficient is positive or negative\n",
        "coefficient_table[\"Direction\"] = np.where(\n",
        "    coefficient_table[\"Coefficient\"] > 0,\n",
        "    \"Positive\",\n",
        "    np.where(\n",
        "        coefficient_table[\"Coefficient\"] < 0,\n",
        "        \"Negative\",\n",
        "        \"Zero\"\n",
        "    )\n",
        ")\n",
        "\n",
        "# Absolute coefficient for comparing relative influence\n",
        "coefficient_table[\"Absolute_Influence\"] = (\n",
        "    coefficient_table[\"Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "# Rank features by absolute coefficient\n",
        "coefficient_table = coefficient_table.sort_values(\n",
        "    by=\"Absolute_Influence\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Display coefficient interpretation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"TASK 15: INTERPRETATION OF REGRESSION COEFFICIENTS\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\"\\nIntercept (β0):\")\n",
        "print(f\"{beta[0]:.6f}\")\n",
        "\n",
        "print(\"\\nCoefficient interpretation:\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "for _, row in coefficient_table.iterrows():\n",
        "\n",
        "    feature = row[\"Feature\"]\n",
        "    coefficient = row[\"Coefficient\"]\n",
        "    direction = row[\"Direction\"]\n",
        "\n",
        "    print(f\"\\nFeature: {feature}\")\n",
        "    print(f\"Coefficient: {coefficient:.6f}\")\n",
        "    print(f\"Direction: {direction}\")\n",
        "\n",
        "    if coefficient > 0:\n",
        "        print(\n",
        "            \"Interpretation: A one-unit increase in this feature \"\n",
        "            \"is associated with an increase in predicted Selling_Price, \"\n",
        "            \"while keeping other variables constant.\"\n",
        "        )\n",
        "\n",
        "    elif coefficient < 0:\n",
        "        print(\n",
        "            \"Interpretation: A one-unit increase in this feature \"\n",
        "            \"is associated with a decrease in predicted Selling_Price, \"\n",
        "            \"while keeping other variables constant.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "        print(\n",
        "            \"Interpretation: This feature has no estimated linear \"\n",
        "            \"effect on Selling_Price in the fitted model.\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5: Display ranking by relative influence\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\\nFEATURES RANKED BY RELATIVE INFLUENCE\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "display(\n",
        "    coefficient_table[\n",
        "        [\"Feature\", \"Coefficient\", \"Direction\", \"Absolute_Influence\"]\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6: Identify the most influential features\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "top_n = min(5, len(coefficient_table))\n",
        "\n",
        "print(f\"\\nTop {top_n} features by absolute coefficient:\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "for i in range(top_n):\n",
        "    feature = coefficient_table.loc[i, \"Feature\"]\n",
        "    coefficient = coefficient_table.loc[i, \"Coefficient\"]\n",
        "\n",
        "    print(\n",
        "        f\"{i + 1}. {feature}: \"\n",
        "        f\"coefficient = {coefficient:.6f}\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7: Check whether features were standardized\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "standardized_features = []\n",
        "\n",
        "# If Task 8 created X_train_scaled, identify standardized columns\n",
        "if \"X_train_scaled\" in globals():\n",
        "\n",
        "    if isinstance(X_train_scaled, pd.DataFrame):\n",
        "\n",
        "        # Compare standard deviation of each feature.\n",
