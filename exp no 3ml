    {
      "cell_type": "code",
      "source": [
        "# TASK 14: TRAIN THE REGRESSION MODEL USING OLS\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1: Check that training data exists\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if \"X_train\" not in globals():\n",
        "    raise ValueError(\"X_train was not found. Please run Task 9 first.\")\n",
        "\n",
        "if \"y_train\" not in globals():\n",
        "    raise ValueError(\"y_train was not found. Please run Task 9 first.\")\n",
        "\n",
        "# Convert training data to NumPy arrays\n",
        "X_train_data = np.asarray(X_train, dtype=float)\n",
        "y_train_data = np.asarray(y_train, dtype=float).reshape(-1)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 2: Check dimensions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if X_train_data.shape[0] != y_train_data.shape[0]:\n",
        "    raise ValueError(\n",
        "        \"X_train and y_train must have the same number of rows.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3: Add the intercept/bias column\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "bias_column = np.ones((X_train_data.shape[0], 1))\n",
        "\n",
        "Xtrain_bias = np.hstack((bias_column, X_train_data))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Define the OLS function\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def OLS(X, y):\n",
        "    \"\"\"\n",
        "    Ordinary Least Squares using matrix operations.\n",
        "\n",
        "    beta = (X^T X)^(-1) X^T y\n",
        "    \"\"\"\n",
        "\n",
        "    XTX = X.T @ X\n",
        "    XTy = X.T @ y\n",
        "\n",
        "    # Pseudo-inverse prevents errors if X^T X is singular\n",
        "    beta = np.linalg.pinv(XTX) @ XTy\n",
        "\n",
        "    return beta\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5: Train the regression model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "beta = OLS(Xtrain_bias, y_train_data)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6: Get feature names\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Try to obtain feature names from X_train if it is a DataFrame\n",
        "if isinstance(X_train, pd.DataFrame):\n",
        "    feature_names = X_train.columns.tolist()\n",
        "\n",
        "else:\n",
        "    # If X_train is a NumPy array, create generic feature names\n",
        "    feature_names = [\n",
        "        \"Feature_\" + str(i + 1)\n",
        "        for i in range(X_train_data.shape[1])\n",
        "    ]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7: Display the regression coefficients\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"TASK 14: TRAIN THE REGRESSION MODEL\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nRegression coefficient vector (β):\")\n",
        "print(beta)\n",
        "\n",
        "print(\"\\nIntercept coefficient (β0):\")\n",
        "print(beta[0])\n",
        "\n",
        "print(\"\\nCoefficients for each feature:\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "for feature, coefficient in zip(feature_names, beta[1:]):\n",
        "    print(f\"{feature:30s} : {coefficient:.6f}\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 8: Create a coefficient table\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "coefficient_table = pd.DataFrame({\n",
        "    \"Feature\": [\"Intercept\"] + feature_names,\n",
        "    \"Coefficient\": beta\n",
        "})\n",
        "\n",
        "print(\"\\nComplete coefficient table:\")\n",
        "display(coefficient_table)\n",
        "\n",
        "print(\"\\nNumber of predictors:\", len(feature_names))\n",
        "print(\"Number of coefficients:\", len(beta))\n",
        "\n",
        "print(\"\\nTask 14 completed successfully!\")"
      ],
