        "\n",
        "print(\"\\n\\nFINAL OBSERVATIONS\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "positive_count = np.sum(coefficients > 0)\n",
        "negative_count = np.sum(coefficients < 0)\n",
        "zero_count = np.sum(coefficients == 0)\n",
        "\n",
        "print(f\"Positive coefficients: {positive_count}\")\n",
