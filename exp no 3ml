        "                f\"A one-standard-deviation increase in {feature} \"\n",
        "                f\"is associated with an estimated increase of \"\n",
        "                f\"{coefficient:.6f} units in predicted Selling_Price, \"\n",
        "                f\"holding all other variables constant.\"\n",
        "            )\n",
        "\n",
        "        elif coefficient < 0:\n",
        "            print(\n",
        "                f\"\\n{feature}: {coefficient:.6f}\"\n",
        "            )\n",
        "            print(\n",
        "                f\"A one-standard-deviation increase in {feature} \"\n",
        "                f\"is associated with an estimated decrease of \"\n",
        "                f\"{abs(coefficient):.6f} units in predicted Selling_Price, \"\n",
        "                f\"holding all other variables constant.\"\n",
        "            )\n",
        "\n",
        "else:\n",
        "    print(\n",
