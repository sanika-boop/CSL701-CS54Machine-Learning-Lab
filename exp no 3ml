        "# TASK 8: STANDARDIZE NUMERICAL FEATURES\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 1: Prepare X and y\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Make a copy of the current dataset\n",
        "data = df.copy()\n",
        "\n",
        "# Clean column names\n",
        "data.columns = data.columns.str.strip()\n",
        "\n",
        "# Find Selling_Price column\n",
        "target_column = None\n",
        "\n",
        "for column in data.columns:\n",
        "    if column.lower().replace(\" \", \"_\") == \"selling_price\":\n",
        "        target_column = column\n",
        "        break\n",
        "\n",
        "if target_column is None:\n",
        "    raise ValueError(\"Selling_Price column was not found.\")\n",
        "\n",
        "# Make sure Selling_Price is numeric\n",
        "data[target_column] = pd.to_numeric(\n",
        "    data[target_column],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# Remove rows with missing target values\n",
        "data = data.dropna(subset=[target_column]).copy()\n",
        "\n",
        "# Separate predictors and target\n",
        "X = data.drop(columns=[target_column])\n",
        "y = data[target_column].astype(float)\n",
        "\n",
        "# Convert categorical variables to dummy variables\n",
        "categorical_columns = X.select_dtypes(\n",
        "    include=[\"object\", \"category\"]\n",
        ").columns.tolist()\n",
        "\n",
        "if len(categorical_columns) > 0:\n",
        "    X = pd.get_dummies(\n",
        "        X,\n",
        "        columns=categorical_columns,\n",
        "        drop_first=True,\n",
        "        dtype=int\n",
        "    )\n",
        "\n",
        "# Convert all predictors to numeric\n",
        "X = X.apply(pd.to_numeric, errors=\"coerce\")\n",
        "\n",
        "# Handle any missing predictor values\n",
        "X = X.fillna(X.median())\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 2: Split into training and testing data\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Create shuffled indices\n",
        "indices = np.random.permutation(len(X))\n",
        "\n",
        "# Use 80% for training and 20% for testing\n",
        "train_size = int(0.80 * len(X))\n",
        "\n",
        "train_indices = indices[:train_size]\n",
        "test_indices = indices[train_size:]\n",
        "\n",
        "X_train = X.iloc[train_indices].copy()\n",
        "X_test = X.iloc[test_indices].copy()\n",
        "\n",
        "y_train = y.iloc[train_indices].copy()\n",
        "y_test = y.iloc[test_indices].copy()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 3: Identify numerical predictors\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "numerical_features = X_train.select_dtypes(\n",
        "    include=[\"number\"]\n",
        ").columns.tolist()\n",
        "\n",
        "print(\"Numerical predictors to be standardized:\")\n",
        "print(numerical_features)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 4: Calculate mean and standard deviation\n",
        "#         USING TRAINING DATA ONLY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "train_mean = X_train[numerical_features].mean()\n",
        "train_std = X_train[numerical_features].std(ddof=0)\n",
        "\n",
        "# Avoid division by zero for constant columns\n",
        "train_std = train_std.replace(0, 1)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# STEP 5: Standardize training features\n",
        "# ---------------------------------------------------------\n",
