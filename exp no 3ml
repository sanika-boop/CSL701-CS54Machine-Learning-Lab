        "# ------------------------------------------------------------\n",
        "# STEP 4: Calculate Residual Sum of Squares (RSS)\n",
        "# Formula:\n",
        "# RSS = Sum((y_i - y_hat_i)^2)\n",
        "# ------------------------------------------------------------\n",
        "\n",
