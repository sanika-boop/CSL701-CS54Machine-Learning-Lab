        "    ],\n",
        "\n",
        "    \"Before Balancing\": [\n",
        "        before_counts.get(0, 0),\n",
        "        before_counts.get(1, 0)\n",
        "    ],\n",
        "\n",
        "    \"After Balancing\": [\n",
        "        after_counts.get(0, 0),\n",
        "        after_counts.get(1, 0)\n",
        "    ]\n",
        "})\n",
        "\n",
        "display(comparison)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 11: Plot Before and After Class Distribution\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "fig, axes = plt.subplots(\n",
        "    1,\n",
        "    2,\n",
        "    figsize=(12, 5)\n",
        ")\n",
        "\n",
        "\n",
        "# Before balancing\n",
        "axes[0].bar(\n",
        "    [\"Legitimate\", \"Fraudulent\"],\n",
        "    [\n",
        "        before_counts.get(0, 0),\n",
        "        before_counts.get(1, 0)\n",
        "    ]\n",
        ")\n",
        "\n",
        "axes[0].set_title(\n",
        "    \"Before Balancing\"\n",
        ")\n",
        "\n",
        "axes[0].set_xlabel(\n",
        "    \"Transaction Class\"\n",
        ")\n",
        "\n",
        "axes[0].set_ylabel(\n",
        "    \"Number of Transactions\"\n",
        ")\n",
        "\n",
        "axes[0].grid(\n",
        "    axis=\"y\",\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "\n",
        "# After balancing\n",
        "axes[1].bar(\n",
        "    [\"Legitimate\", \"Fraudulent\"],\n",
        "    [\n",
        "        after_counts.get(0, 0),\n",
        "        after_counts.get(1, 0)\n",
