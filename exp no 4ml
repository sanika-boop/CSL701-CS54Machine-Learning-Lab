        "    y_true,\n",
        "    y_prediction\n",
        ")\n",
        "\n",
        "precision = precision_score(\n",
        "    y_true,\n",
        "    y_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "recall = recall_score(\n",
        "    y_true,\n",
        "    y_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "f1 = f1_score(\n",
        "    y_true,\n",
        "    y_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. CREATE FINAL PERFORMANCE SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "performance_summary = pd.DataFrame({\n",
