        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 12: Feature Scaling\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"STANDARDIZATION\")\n",
