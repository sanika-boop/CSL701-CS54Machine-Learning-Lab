        "print(\"y_train shape:\", y_train_np.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. DEFINE SIGMOID FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def sigmoid(z):\n",
        "    \"\"\"\n",
        "    Sigmoid function:\n",
        "\n",
        "        sigmoid(z) = 1 / (1 + e^(-z))\n",
        "\n",
        "    Converts any real-valued number into a value between 0 and 1.\n",
        "    \"\"\"\n",
        "\n",
        "    # Clip z to avoid numerical overflow\n",
        "    z = np.clip(z, -500, 500)\n",
        "\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. TEST SIGMOID FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"SIGMOID FUNCTION TEST\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "sample_values = np.array([-10, -5, -2, 0, 2, 5, 10])\n",
        "\n",
        "sigmoid_values = sigmoid(sample_values)\n",
        "\n",
        "sigmoid_test = pd.DataFrame({\n",
        "    \"Input (z)\": sample_values,\n",
        "    \"Sigmoid Output\": sigmoid_values\n",
        "})\n",
        "\n",
        "display(sigmoid_test)\n",
        "\n",
        "print(\"\\nImportant observations:\")\n",
        "print(\"Sigmoid(-10) is close to 0.\")\n",
        "print(\"Sigmoid(0) = 0.5.\")\n",
        "print(\"Sigmoid(10) is close to 1.\")\n",
        "print(\"All sigmoid outputs lie between 0 and 1.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. INITIALIZE WEIGHTS AND BIAS\n",
        "# ============================================================\n",
        "\n",
        "number_of_features = X_train_np.shape[1]\n",
        "\n",
        "# Initialize all weights to zero\n",
        "w = np.zeros(number_of_features)\n",
        "\n",
