        "# ============================================================\n",
        "# TASK 10: ROC CURVE, AUC AND FINAL PERFORMANCE SUMMARY\n",
        "# Credit Card Fraud Detection\n",
        "# Logistic Regression from Scratch\n",
        "# Google Colab - Error-Free Code\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    roc_curve,\n",
        "    roc_auc_score,\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "print(\"Libraries imported successfully!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. VERIFY REQUIRED VARIABLES\n",
        "# ============================================================\n",
        "\n",
        "required_variables = [\n",
        "    \"y_test_np\",\n",
        "    \"y_test_probability\",\n",
        "    \"y_test_prediction\"\n",
        "]\n",
        "\n",
        "missing_variables = [\n",
        "    variable\n",
