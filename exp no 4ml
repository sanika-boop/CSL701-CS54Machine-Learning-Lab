        "    f\"Total          : {len(X_train) + len(X_val) + len(X_test):,} samples \"\n",
        "    f\"(100%)\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 8: Check Stratification\n",
        "# ------------------------------------------------------------\n",
        "\n",
