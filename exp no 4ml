        "\n",
        "print(f\"ROC-AUC = {roc_auc:.4f}\")\n",
        "print(auc_interpretation)\n",
        "\n",
        "print(\"\"\"\n",
        "ROC-AUC measures how well the model separates fraudulent\n",
        "transactions from legitimate transactions across different\n",
