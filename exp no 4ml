        "    y_prediction,\n",
        "    labels=[0, 1]\n",
        ")\n",
        "\n",
        "TN, FP, FN, TP = cm.ravel()\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CONFUSION MATRIX\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(cm)\n",
        "\n",
        "print(\"\\nTrue Negative  (TN):\", TN)\n",
        "print(\"False Positive (FP):\", FP)\n",
        "print(\"False Negative (FN):\", FN)\n",
        "print(\"True Positive   (TP):\", TP)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. CALCULATE PERFORMANCE METRICS\n",
        "# ============================================================\n",
        "\n",
