        "# ============================================================\n",
        "# TASK 8: GENERATE PREDICTIONS AND EVALUATE CONFUSION MATRIX\n",
        "# Credit Card Fraud Detection\n",
        "# Logistic Regression from Scratch\n",
        "# Google Colab - Error-Free Code\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "print(\"Libraries imported successfully!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. VERIFY REQUIRED VARIABLES FROM PREVIOUS TASKS\n",
        "# ============================================================\n",
        "\n",
        "required_variables = [\n",
        "    \"X_val\",\n",
        "    \"y_val\",\n",
        "    \"X_test\",\n",
        "    \"y_test\",\n",
        "    \"w\",\n",
        "    \"b\"\n",
        "]\n",
        "\n",
        "missing_variables = [\n",
        "    variable for variable in required_variables\n",
        "    if variable not in globals()\n",
        "]\n",
        "\n",
        "if missing_variables:\n",
        "    raise ValueError(\n",
        "        \"ERROR: The following required variables are missing:\\n\"\n",
        "        + \", \".join(missing_variables)\n",
        "        + \"\\n\\nPlease run Tasks 5, 6, and 7 first.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nAll required variables are available.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. CONVERT VALIDATION AND TEST DATA TO NUMPY\n",
        "# ============================================================\n",
        "\n",
        "X_val_np = np.asarray(X_val, dtype=float)\n",
        "y_val_np = np.asarray(y_val, dtype=int).reshape(-1)\n",
        "\n",
        "X_test_np = np.asarray(X_test, dtype=float)\n",
        "y_test_np = np.asarray(y_test, dtype=int).reshape(-1)\n",
        "\n",
        "w_np = np.asarray(w, dtype=float).reshape(-1)\n",
        "b_value = float(b)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. VERIFY DIMENSIONS\n",
        "# ============================================================\n",
        "\n",
        "if X_val_np.shape[1] != len(w_np):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Number of validation features does not match \"\n",
        "        \"the number of trained weights.\"\n",
        "    )\n",
        "\n",
        "if X_test_np.shape[1] != len(w_np):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Number of test features does not match \"\n",
        "        \"the number of trained weights.\"\n",
        "    )\n",
        "\n",
        "if len(X_val_np) != len(y_val_np):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Validation features and labels have different lengths.\"\n",
        "    )\n",
        "\n",
        "if len(X_test_np) != len(y_test_np):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Test features and labels have different lengths.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"DATA VERIFICATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Validation features:\", X_val_np.shape)\n",
        "print(\"Validation labels  :\", y_val_np.shape)\n",
        "print(\"Test features      :\", X_test_np.shape)\n",
        "print(\"Test labels        :\", y_test_np.shape)\n",
        "\n",
        "print(\"Weight vector       :\", w_np.shape)\n",
        "print(\"Bias                :\", b_value)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. DEFINE SIGMOID FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def sigmoid(z):\n",
        "    \"\"\"\n",
        "    Sigmoid function:\n",
        "\n",
        "        sigmoid(z) = 1 / (1 + exp(-z))\n",
        "    \"\"\"\n",
        "\n",
        "    # Prevent numerical overflow\n",
        "    z = np.clip(z, -500, 500)\n",
        "\n",
        "    return 1.0 / (1.0 + np.exp(-z))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DEFINE PREDICTION FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def predict_probability(X, weights, bias):\n",
        "    \"\"\"\n",
        "    Calculate predicted probability:\n",
        "\n",
        "        y_hat = sigmoid(Xw + b)\n",
        "    \"\"\"\n",
        "\n",
        "    z = np.dot(X, weights) + bias\n",
        "\n",
        "    return sigmoid(z)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. SET CLASSIFICATION THRESHOLD\n",
        "# ============================================================\n",
        "\n",
        "threshold = 0.5\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CLASSIFICATION THRESHOLD\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Threshold =\", threshold)\n",
        "\n",
        "print(\"\"\"\n",
        "If predicted probability >= 0.5:\n",
        "    Predicted class = 1 (Fraud)\n",
        "\n",
        "If predicted probability < 0.5:\n",
        "    Predicted class = 0 (Legitimate)\n",
        "\"\"\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. GENERATE VALIDATION PROBABILITIES\n",
        "# ============================================================\n",
        "\n",
        "y_val_probability = predict_probability(\n",
        "    X_val_np,\n",
        "    w_np,\n",
        "    b_value\n",
        ")\n",
        "\n",
        "# Convert probabilities into class labels\n",
        "y_val_prediction = (\n",
        "    y_val_probability >= threshold\n",
        ").astype(int)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. GENERATE TEST PROBABILITIES\n",
        "# ============================================================\n",
        "\n",
        "y_test_probability = predict_probability(\n",
        "    X_test_np,\n",
        "    w_np,\n",
        "    b_value\n",
        ")\n",
        "\n",
        "# Convert probabilities into class labels\n",
        "y_test_prediction = (\n",
        "    y_test_probability >= threshold\n",
        ").astype(int)\n",
        "\n",
