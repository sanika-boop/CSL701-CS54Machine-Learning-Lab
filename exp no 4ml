        "print(\"y_train shape:\", y_train_np.shape)\n",
        "print(\"Number of samples:\", X_train_np.shape[0])\n",
        "print(\"Number of features:\", X_train_np.shape[1])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. DEFINE SIGMOID FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def sigmoid(z):\n",
        "    \"\"\"\n",
        "    Sigmoid function:\n",
        "\n",
        "        sigmoid(z) = 1 / (1 + e^(-z))\n",
        "\n",
        "    Converts the linear output into a probability between 0 and 1.\n",
        "    \"\"\"\n",
        "\n",
        "    # Prevent numerical overflow\n",
        "    z = np.clip(z, -500, 500)\n",
        "\n",
        "    return 1.0 / (1.0 + np.exp(-z))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. DEFINE BINARY CROSS-ENTROPY COST FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def compute_cost(X, y, w, b):\n",
        "    \"\"\"\n",
        "    Binary Cross-Entropy Cost:\n",
        "\n",
        "        J = -(1/m) * sum[\n",
        "            y*log(y_hat) +\n",
        "            (1-y)*log(1-y_hat)\n",
        "        ]\n",
        "    \"\"\"\n",
        "\n",
        "    m = X.shape[0]\n",
        "\n",
        "    # Calculate linear output\n",
        "    z = np.dot(X, w) + b\n",
        "\n",
        "    # Calculate predicted probabilities\n",
        "    y_hat = sigmoid(z)\n",
        "\n",
        "    # Prevent log(0)\n",
        "    epsilon = 1e-15\n",
        "    y_hat = np.clip(y_hat, epsilon, 1 - epsilon)\n",
        "\n",
        "    # Calculate cost\n",
        "    cost = -(1.0 / m) * np.sum(\n",
        "        y * np.log(y_hat) +\n",
        "        (1 - y) * np.log(1 - y_hat)\n",
        "    )\n",
        "\n",
        "    return cost\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. DEFINE GRADIENT DESCENT FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def train_logistic_regression(\n",
        "    X,\n",
        "    y,\n",
        "    learning_rate=0.01,\n",
        "    iterations=1000\n",
        "):\n",
        "    \"\"\"\n",
        "    Logistic Regression training using Gradient Descent.\n",
        "\n",
        "    Parameters:\n",
        "        X              : Training features\n",
        "        y              : Training labels\n",
        "        learning_rate  : Alpha\n",
        "        iterations     : Number of Gradient Descent iterations\n",
        "\n",
        "    Returns:\n",
        "        w              : Learned weight vector\n",
        "        b              : Learned bias\n",
        "        cost_history   : Cost at each iteration\n",
        "    \"\"\"\n",
        "\n",
        "    # Number of training examples\n",
        "    m = X.shape[0]\n",
        "\n",
        "    # Number of features\n",
        "    n = X.shape[1]\n",
        "\n",
        "    # Initialize weights\n",
        "    w = np.zeros(n, dtype=float)\n",
        "\n",
        "    # Initialize bias\n",
        "    b = 0.0\n",
        "\n",
        "    # Store cost values\n",
        "    cost_history = []\n",
        "\n",
        "    # ========================================================\n",
        "    # Gradient Descent Loop\n",
        "    # ========================================================\n",
        "\n",
        "    for i in range(iterations):\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Step 1: Calculate predicted probability\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        z = np.dot(X, w) + b\n",
        "\n",
        "        y_hat = sigmoid(z)\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Step 2: Calculate gradients\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        error = y_hat - y\n",
        "\n",
        "        # Gradient with respect to weights\n",
        "        dw = (1.0 / m) * np.dot(X.T, error)\n",
        "\n",
        "        # Gradient with respect to bias\n",
        "        db = (1.0 / m) * np.sum(error)\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Step 3: Update weights and bias\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        w = w - learning_rate * dw\n",
        "\n",
        "        b = b - learning_rate * db\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Step 4: Calculate and store cost\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        cost = compute_cost(X, y, w, b)\n",
        "\n",
        "        cost_history.append(cost)\n",
        "\n",
        "    return w, b, cost_history\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. SET HYPERPARAMETERS\n",
        "# ============================================================\n",
        "\n",
        "learning_rate = 0.01\n",
        "iterations = 1000\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MODEL HYPERPARAMETERS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Learning Rate:\", learning_rate)\n",
