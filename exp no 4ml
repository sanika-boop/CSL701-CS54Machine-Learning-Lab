        "print(\"=\" * 70)\n",
        "\n",
        "after_counts = y_balanced.value_counts().sort_index()\n",
        "\n",
        "after_distribution = pd.DataFrame({\n",
        "    \"Class\": after_counts.index,\n",
        "    \"Number of Transactions\": after_counts.values\n",
        "})\n",
        "\n",
        "after_distribution[\"Percentage (%)\"] = (\n",
        "    after_distribution[\"Number of Transactions\"]\n",
        "    / len(y_balanced)\n",
        ") * 100\n",
        "\n",
        "display(after_distribution)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 10: Compare Before and After Balancing\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"BEFORE VS AFTER BALANCING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "comparison = pd.DataFrame({\n",
