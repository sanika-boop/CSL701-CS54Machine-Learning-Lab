        "# Convert remaining columns to numeric\n",
        "X = X.apply(pd.to_numeric, errors=\"coerce\")\n",
        "\n",
        "\n",
        "# Handle missing values\n",
        "for column in X.columns:\n",
        "\n",
        "    if X[column].isnull().sum() > 0:\n",
        "\n",
        "        X[column] = X[column].fillna(\n",
        "            X[column].median()\n",
        "        )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5: Display Original Class Distribution\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CLASS DISTRIBUTION BEFORE BALANCING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "before_counts = y.value_counts().sort_index()\n",
        "\n",
        "before_distribution = pd.DataFrame({\n",
        "    \"Class\": before_counts.index,\n",
        "    \"Number of Transactions\": before_counts.values\n",
        "})\n",
        "\n",
        "before_distribution[\"Percentage (%)\"] = (\n",
        "    before_distribution[\"Number of Transactions\"]\n",
        "    / len(y)\n",
        ") * 100\n",
        "\n",
        "display(before_distribution)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6: Separate Majority and Minority Classes\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Combine X and y temporarily\n",
        "balanced_data = X.copy()\n",
        "balanced_data[\"fraud\"] = y.values\n",
        "\n",
        "majority_class = balanced_data[\n",
        "    balanced_data[\"fraud\"] == 0\n",
        "]\n",
        "\n",
        "minority_class = balanced_data[\n",
        "    balanced_data[\"fraud\"] == 1\n",
        "]\n",
        "\n",
        "print(\"\\nLegitimate transactions:\",\n",
        "      len(majority_class))\n",
        "\n",
        "print(\"Fraudulent transactions:\",\n",
        "      len(minority_class))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7: Random Undersampling\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Reduce legitimate transactions to the number of\n",
        "# fraudulent transactions.\n",
        "\n",
        "if len(minority_class) == 0:\n",
        "\n",
        "    raise ValueError(\n",
        "        \"ERROR: No fraudulent transactions were found.\"\n",
        "    )\n",
        "\n",
        "undersampled_majority = resample(\n",
        "    majority_class,\n",
        "    replace=False,\n",
        "    n_samples=len(minority_class),\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Combine both classes\n",
        "balanced_data = pd.concat(\n",
        "    [\n",
        "        undersampled_majority,\n",
        "        minority_class\n",
        "    ],\n",
        "    axis=0\n",
        ")\n",
        "\n",
        "# Shuffle the data\n",
        "balanced_data = balanced_data.sample(\n",
        "    frac=1,\n",
        "    random_state=42\n",
        ").reset_index(drop=True)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 8: Create Balanced X and y\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X_balanced = balanced_data.drop(\n",
        "    columns=[\"fraud\"]\n",
        ")\n",
        "\n",
        "y_balanced = balanced_data[\"fraud\"]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 9: Display Class Distribution After Balancing\n",
        "# ------------------------------------------------------------\n",
        "\n",
