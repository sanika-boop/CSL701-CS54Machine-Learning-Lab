        "\n",
        "# ============================================================\n",
        "# 7. CALCULATE INITIAL COST\n",
        "# ============================================================\n",
        "\n",
        "initial_cost = compute_cost(\n",
        "    X_train_np,\n",
        "    y_train_np,\n",
        "    initial_w,\n",
        "    initial_b\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"INITIAL COST\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Initial Cost:\", initial_cost)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. TRAIN LOGISTIC REGRESSION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"TRAINING LOGISTIC REGRESSION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "w, b, cost_history = train_logistic_regression(\n",
        "    X_train_np,\n",
        "    y_train_np,\n",
