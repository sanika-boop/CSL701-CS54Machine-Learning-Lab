        "\n",
        "# ============================================================\n",
        "# 5. DEFINE PREDICTION FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def predict_probability(X, w, b):\n",
        "    \"\"\"\n",
        "    Calculates predicted probability:\n",
        "\n",
        "        z = Xw + b\n",
        "        y_hat = sigmoid(z)\n",
        "    \"\"\"\n",
        "\n",
        "    z = np.dot(X, w) + b\n",
        "\n",
        "    return sigmoid(z)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. DEFINE BINARY CROSS-ENTROPY COST FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def binary_cross_entropy_cost(y_true, y_pred):\n",
        "    \"\"\"\n",
        "    Binary Cross-Entropy Cost:\n",
        "\n",
        "    J = -(1/m) * sum[\n",
        "            y * log(y_pred)\n",
        "            + (1-y) * log(1-y_pred)\n",
        "        ]\n",
        "\n",
        "    Small epsilon is used to avoid log(0).\n",
        "    \"\"\"\n",
        "\n",
        "    y_true = np.asarray(y_true, dtype=float)\n",
        "    y_pred = np.asarray(y_pred, dtype=float)\n",
        "\n",
        "    # Prevent log(0)\n",
        "    epsilon = 1e-15\n",
        "\n",
        "    y_pred = np.clip(y_pred, epsilon, 1 - epsilon)\n",
        "\n",
        "    m = len(y_true)\n",
        "\n",
        "    cost = -(1 / m) * np.sum(\n",
        "        y_true * np.log(y_pred)\n",
        "        + (1 - y_true) * np.log(1 - y_pred)\n",
        "    )\n",
        "\n",
        "    return cost\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. CALCULATE INITIAL PREDICTIONS\n",
        "# ============================================================\n",
        "\n",
        "y_pred_initial = predict_probability(\n",
        "    X_train_np,\n",
