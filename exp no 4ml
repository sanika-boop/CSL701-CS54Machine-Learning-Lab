        "\n",
        "plt.xlim([0, 1])\n",
        "plt.ylim([0, 1.05])\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. CALCULATE CONFUSION MATRIX\n",
        "# ============================================================\n",
        "\n",
        "cm = confusion_matrix(\n",
