        "    if variable not in globals()\n",
        "]\n",
        "\n",
        "if missing_variables:\n",
        "    raise ValueError(\n",
        "        \"ERROR: The following required variables are missing:\\n\"\n",
        "        + \", \".join(missing_variables)\n",
        "        + \"\\n\\nPlease run Tasks 8 and 9 first.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nAll required variables are available.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. PREPARE TEST DATA\n",
        "# ============================================================\n",
        "\n",
        "y_true = np.asarray(y_test_np, dtype=int).reshape(-1)\n",
        "y_probability = np.asarray(\n",
        "    y_test_probability,\n",
        "    dtype=float\n",
        ").reshape(-1)\n",
        "\n",
        "y_prediction = np.asarray(\n",
        "    y_test_prediction,\n",
        "    dtype=int\n",
        ").reshape(-1)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. VERIFY DATA\n",
        "# ============================================================\n",
        "\n",
        "if len(y_true) != len(y_probability):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Test labels and predicted probabilities \"\n",
        "        \"have different lengths.\"\n",
        "    )\n",
        "\n",
        "if len(y_true) != len(y_prediction):\n",
        "    raise ValueError(\n",
        "        \"ERROR: Test labels and predicted classes \"\n",
        "        \"have different lengths.\"\n",
        "    )\n",
        "\n",
        "# ROC-AUC requires both classes\n",
        "if len(np.unique(y_true)) < 2:\n",
        "    raise ValueError(\n",
        "        \"ERROR: ROC-AUC cannot be calculated because the \"\n",
        "        \"test dataset contains only one class.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"TEST DATA VERIFICATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Number of test samples:\", len(y_true))\n",
        "print(\"Actual classes:\", np.unique(y_true))\n",
        "print(\"Probability values:\", len(y_probability))\n",
        "print(\"Predicted classes:\", np.unique(y_prediction))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. CALCULATE ROC CURVE\n",
        "# ============================================================\n",
        "\n",
        "fpr, tpr, thresholds = roc_curve(\n",
        "    y_true,\n",
        "    y_probability\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"ROC CURVE VALUES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "roc_table = pd.DataFrame({\n",
        "    \"Threshold\": thresholds,\n",
        "    \"False Positive Rate (FPR)\": fpr,\n",
        "    \"True Positive Rate (TPR)\": tpr\n",
        "})\n",
        "\n",
        "display(roc_table.head(10))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. CALCULATE ROC-AUC\n",
        "# ============================================================\n",
        "\n",
        "roc_auc = roc_auc_score(\n",
        "    y_true,\n",
        "    y_probability\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"ROC-AUC SCORE\")\n",
        "print(\"=\" * 70)\n",
