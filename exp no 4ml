        "print(\"CLASS DISTRIBUTION IN EACH SUBSET\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "def class_distribution(y_data, dataset_name):\n",
        "\n",
        "    counts = y_data.value_counts().sort_index()\n",
        "\n",
        "    percentages = (\n",
        "        counts / len(y_data)\n",
        "    ) * 100\n",
        "\n",
        "    result = pd.DataFrame({\n",
        "        \"Dataset\": dataset_name,\n",
        "        \"Class\": counts.index,\n",
        "        \"Count\": counts.values,\n",
        "        \"Percentage (%)\": percentages.values\n",
        "    })\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "train_distribution = class_distribution(\n",
