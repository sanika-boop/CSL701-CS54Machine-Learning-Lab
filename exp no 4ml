        "# ============================================================\n",
        "# TASK 7: LOGISTIC REGRESSION USING GRADIENT DESCENT\n",
        "# Credit Card Fraud Detection\n",
        "# Implemented from Scratch using NumPy\n",
        "# Google Colab - Error-Free Code\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "print(\"Libraries imported successfully!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. VERIFY TRAINING DATA\n",
        "# ============================================================\n",
        "\n",
        "if \"X_train\" not in globals() or \"y_train\" not in globals():\n",
        "    raise ValueError(\n",
        "        \"ERROR: X_train and y_train were not found.\\n\"\n",
        "        \"Please run Task 5 first.\"\n",
        "    )\n",
        "\n",
        "# Convert to NumPy arrays\n",
        "X_train_np = np.asarray(X_train, dtype=float)\n",
        "y_train_np = np.asarray(y_train, dtype=float).reshape(-1)\n",
        "\n",
        "# Check dimensions\n",
        "if X_train_np.shape[0] != y_train_np.shape[0]:\n",
        "    raise ValueError(\n",
        "        \"ERROR: X_train and y_train have different numbers of samples.\"\n",
        "    )\n",
        "\n",
        "if X_train_np.shape[0] == 0:\n",
        "    raise ValueError(\"ERROR: Training dataset is empty.\")\n",
        "\n",
        "if X_train_np.shape[1] == 0:\n",
