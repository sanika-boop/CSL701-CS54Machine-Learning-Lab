      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# TASK 9: CALCULATE PRECISION, RECALL AND F1-SCORE\n",
        "# Credit Card Fraud Detection\n",
        "# Logistic Regression from Scratch\n",
        "# Google Colab - Error-Free Code\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score\n",
        ")\n",
        "\n",
        "print(\"Libraries imported successfully!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. VERIFY REQUIRED VARIABLES FROM TASK 8\n",
        "# ============================================================\n",
        "\n",
        "required_variables = [\n",
        "    \"y_test_np\",\n",
        "    \"y_test_prediction\",\n",
        "    \"TN_test\",\n",
        "    \"FP_test\",\n",
        "    \"FN_test\",\n",
        "    \"TP_test\"\n",
        "]\n",
        "\n",
        "missing_variables = [\n",
        "    variable\n",
        "    for variable in required_variables\n",
        "    if variable not in globals()\n",
        "]\n",
        "\n",
        "if missing_variables:\n",
        "    raise ValueError(\n",
        "        \"ERROR: The following variables are missing:\\n\"\n",
        "        + \", \".join(missing_variables)\n",
        "        + \"\\n\\nPlease run Task 8 first.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nAll required variables from Task 8 are available.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. GET CONFUSION MATRIX VALUES\n",
        "# ============================================================\n",
        "\n",
        "TN = int(TN_test)\n",
        "FP = int(FP_test)\n",
        "FN = int(FN_test)\n",
        "TP = int(TP_test)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CONFUSION MATRIX VALUES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"True Negative  (TN):\", TN)\n",
        "print(\"False Positive (FP):\", FP)\n",
        "print(\"False Negative (FN):\", FN)\n",
        "print(\"True Positive   (TP):\", TP)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. CALCULATE ACCURACY MANUALLY\n",
        "# ============================================================\n",
        "\n",
        "total = TP + TN + FP + FN\n",
        "\n",
        "if total == 0:\n",
        "    raise ValueError(\"ERROR: Total number of samples is zero.\")\n",
        "\n",
        "accuracy_manual = (TP + TN) / total\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. CALCULATE PRECISION MANUALLY\n",
        "# ============================================================\n",
        "\n",
        "if (TP + FP) == 0:\n",
        "    precision_manual = 0.0\n",
        "else:\n",
        "    precision_manual = TP / (TP + FP)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. CALCULATE RECALL MANUALLY\n",
        "# ============================================================\n",
        "\n",
        "if (TP + FN) == 0:\n",
        "    recall_manual = 0.0\n",
        "else:\n",
        "    recall_manual = TP / (TP + FN)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. CALCULATE F1-SCORE MANUALLY\n",
        "# ============================================================\n",
        "\n",
        "if (precision_manual + recall_manual) == 0:\n",
        "    f1_manual = 0.0\n",
        "else:\n",
        "    f1_manual = (\n",
        "        2 * precision_manual * recall_manual\n",
        "        / (precision_manual + recall_manual)\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DISPLAY MANUAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MANUALLY CALCULATED PERFORMANCE METRICS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Accuracy  : {accuracy_manual:.4f}\")\n",
        "print(f\"Precision : {precision_manual:.4f}\")\n",
        "print(f\"Recall    : {recall_manual:.4f}\")\n",
        "print(f\"F1-Score  : {f1_manual:.4f}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. CALCULATE METRICS USING SCIKIT-LEARN\n",
        "#    Used only to verify our manual calculations\n",
        "# ============================================================\n",
        "\n",
        "accuracy_sklearn = accuracy_score(\n",
        "    y_test_np,\n",
        "    y_test_prediction\n",
        ")\n",
        "\n",
        "precision_sklearn = precision_score(\n",
        "    y_test_np,\n",
        "    y_test_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "recall_sklearn = recall_score(\n",
        "    y_test_np,\n",
        "    y_test_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "f1_sklearn = f1_score(\n",
        "    y_test_np,\n",
        "    y_test_prediction,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "\n",
