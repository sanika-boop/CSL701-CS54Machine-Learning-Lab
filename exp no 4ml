        "    )\n",
        "\n",
        "if y_final.nunique() < 2:\n",
        "\n",
        "    raise ValueError(\n",
        "        \"ERROR: The target variable must contain both classes \"\n",
        "        \"(0 = legitimate, 1 = fraud).\"\n",
        "    )\n",
        "\n",
        "\n",
        "print(\"\\nDataset ready for splitting.\")\n",
        "print(\"Feature shape:\", X_final.shape)\n",
        "print(\"Target shape :\", y_final.shape)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Display Overall Class Distribution\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
