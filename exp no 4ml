        ")\n",
        "\n",
        "test_distribution = class_distribution(\n",
        "    y_test,\n",
        "    \"Test\"\n",
        ")\n",
        "\n",
        "distribution_table = pd.concat(\n",
        "    [\n",
        "        train_distribution,\n",
        "        validation_distribution,\n",
